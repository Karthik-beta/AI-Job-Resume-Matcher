generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  runtime      = "bun"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Settings {
  userId            String   @id
  resumeUrl         String?
  discordWebhookUrl String?
  experienceYears   Int      @default(0)
  experienceMonths  Int      @default(0) // 0-11
  targetMinYears    Float?
  targetMaxYears    Float?
  locations         String[]
  includeUnknown    Boolean  @default(true)
  // Job titles must contain one of these words or phrases (none = any title).
  titleInclude      String[] @default([])
  // Job titles must not contain any of these.
  titleExclude      String[] @default([])
  maxJobsPerRun     Int      @default(5) // 1-20
  // Rank job titles against the resume before reading job pages.
  triageEnabled     Boolean  @default(true)
  scheduleMinutes   Int? // null = no scheduled checks
}

enum SourceKind {
  GREENHOUSE
  LEVER
  ASHBY
  SMARTRECRUITERS
  RECRUITEE
  SEARCH
  PAGE
}

model JobSource {
  id                  String      @id @default(uuid(7))
  userId              String
  url                 String
  kind                SourceKind  @default(PAGE)
  adapterKey          String? // ATS board token or company slug
  query               String? // SEARCH sources
  selector            String?
  maxPages            Int         @default(3)
  // Read a page source's job links from Firecrawl's map of the site before scraping it.
  useMap              Boolean     @default(false)
  listingHash         String?
  // An ATS board found embedded in a page source, offered to the user as a switch.
  suggestedKind       SourceKind?
  suggestedAdapterKey String?
  lastCheckedAt       DateTime?
  createdAt           DateTime    @default(now())

  @@unique([userId, url])
}

enum RunStatus {
  QUEUED
  RUNNING
  COMPLETED
  STOPPED
  FAILED
}

enum RunTrigger {
  MANUAL
  SCHEDULED
}

model Run {
  id         String      @id @default(uuid(7))
  userId     String
  trigger    RunTrigger
  status     RunStatus   @default(QUEUED)
  contextKey String // hash of resume content + source ids + model + requirements
  sourceIds  String[]
  found      Int         @default(0)
  eligible   Int         @default(0)
  checked    Int         @default(0)
  failed     Int         @default(0)
  stopReason String?
  createdAt  DateTime    @default(now())
  finishedAt DateTime?
  results    JobResult[]

  @@index([userId, createdAt])
}

enum SkipReason {
  EXPIRED // the job page's structured data says the posting has closed
  TRIAGE // title triage ranked it below the threshold
}

model JobResult {
  id          String      @id @default(uuid(7))
  runId       String
  run         Run         @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId      String
  contextKey  String
  jobUrl      String
  title       String
  company     String
  locations   String[]
  expMinYears Float?
  expMaxYears Float?
  isMatch     Boolean? // null when the job errored or was skipped
  reason      String?
  error       String?
  skipped     SkipReason? // set when the job was settled without an evaluation
  matchSaved  Boolean     @default(false)
  createdAt   DateTime    @default(now())

  @@unique([userId, contextKey, jobUrl])
}

enum MatchStatus {
  PENDING
  APPLIED
}

model Match {
  id          String      @id @default(uuid(7))
  userId      String
  jobUrl      String
  title       String
  company     String
  locations   String[]
  expMinYears Float?
  expMaxYears Float?
  reason      String
  status      MatchStatus @default(PENDING)
  matchedAt   DateTime    @default(now())

  @@unique([userId, jobUrl])
}

enum CacheKind {
  RESUME
  JOB_PAGE
  SOURCE_LISTING
}

model PageCache {
  userId    String
  url       String
  kind      CacheKind
  content   Json // job page markdown, extracted listings, or the resume text with its hash
  expiresAt DateTime? // null = never expires
  createdAt DateTime  @default(now())

  @@id([userId, url, kind])
}

// Sites that block the local Firecrawl, so hybrid runs send them straight to the cloud.
// Shared by every user, like the sites themselves.
model ScrapeRoute {
  domain           String    @id
  localBlocks      Int       @default(0) // consecutive local blocks; a local success resets it
  preferCloudUntil DateTime?
  updatedAt        DateTime  @updatedAt
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
