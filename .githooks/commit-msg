#!/bin/sh
# Rejects co-author and "Generated with" trailers. Merge commits are skipped.
git rev-parse -q --verify MERGE_HEAD >/dev/null && exit 0

if grep -v '^#' "$1" | grep -iqE '^[[:space:]]*co-authored-by:|generated with'; then
  echo "commit-msg: remove the Co-Authored-By / \"Generated with\" lines from the message." >&2
  exit 1
fi
