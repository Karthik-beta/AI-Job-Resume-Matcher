{
  "name": "@job-matcher/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel --no-exit-on-error dev:server dev:worker",
    "dev:server": "bun --env-file=../../.env --watch src/main.ts",
    "dev:worker": "bun --env-file=../../.env --watch src/worker.ts",
    "start": "bun --env-file=../../.env src/main.ts",
    "start:worker": "bun --env-file=../../.env src/worker.ts",
    "test": "bun --env-file=../../.env test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/ai-openrouter": "4.0.2",
    "@job-matcher/shared": "workspace:*",
    "@mendable/firecrawl-js": "^4.46.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "^1.7.7",
    "bullmq": "^6.3.12",
    "effect": "^4.0.2",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1"
  }
}
