# Copy to .env
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_matcher
API_PORT=4000
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
BETTER_AUTH_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379
OPENROUTER_MODEL=openai/gpt-6-luna:floor
# Evaluations run on OpenAI's flex tier; max prices are USD per million tokens
OPENROUTER_SERVICE_TIER=flex
OPENROUTER_PROVIDERS=openai
OPENROUTER_MAX_PRICE_PROMPT=0.05
OPENROUTER_MAX_PRICE_COMPLETION=0.25
OPENROUTER_REASONING_EFFORT=low
# Where pages are scraped: cloud (default), local (a self-hosted Firecrawl, no credits) or
# hybrid (local first; only pages that block it go to the cloud)
FIRECRAWL_MODE=cloud
# For local and hybrid: `bun run dev` (docker compose) then also starts a self-hosted Firecrawl
# on port 3002, which needs about 4 GB of memory under load
# COMPOSE_PROFILES=firecrawl
# Needed for cloud and hybrid
FIRECRAWL_API_KEY=fc-your-key
# Needed for local and hybrid
FIRECRAWL_LOCAL_URL=http://localhost:3002
# Cloud mode's proxy: basic, or auto (retries blocked pages with enhanced proxies)
FIRECRAWL_CLOUD_PROXY=basic
OPENROUTER_API_KEY=sk-or-your-key
# "fake" runs the worker on test fixtures instead of Firecrawl, OpenRouter and Discord
PROVIDERS=live
