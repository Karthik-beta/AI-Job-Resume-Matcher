# Copy to deploy/.env on the host. This file is the template; the real one is never committed.
# Required: long random values, e.g. `openssl rand -hex 32`. Startup fails while they are empty.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# The exact origin people open, e.g. https://jobs.example.com (include the port if WEB_PORT is not 80).
# Sign-in fails with an invalid origin error if this does not match.
BETTER_AUTH_URL=
API_PORT=4000
OPENROUTER_MODEL=openai/gpt-6-luna:floor
# Evaluations run on OpenAI's flex tier; max prices are USD per million tokens
OPENROUTER_SERVICE_TIER=flex
OPENROUTER_PROVIDERS=openai
OPENROUTER_MAX_PRICE_PROMPT=0.05
OPENROUTER_MAX_PRICE_COMPLETION=0.25
OPENROUTER_REASONING_EFFORT=low
# "fake" runs the public demo on fixtures, with no provider keys or costs
PROVIDERS=fake
FIRECRAWL_API_KEY=
OPENROUTER_API_KEY=
