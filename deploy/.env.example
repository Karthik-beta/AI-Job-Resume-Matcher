# Settings for the self-hosted stack. The installer writes this file as .env next to
# compose.yml; to set it up by hand, copy it to .env and fill in the Required section.
# The real .env holds secrets and is never committed.

# --- Required ------------------------------------------------------------------------
# Long random values, e.g. `openssl rand -hex 32`. Startup fails while they are empty.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# The exact origin people open, e.g. http://localhost:8080 or https://jobs.example.com.
# Sign-in fails with an invalid origin error if this does not match.
BETTER_AUTH_URL=
# Port the web app listens on, on the host
WEB_PORT=8080
# Image version to run: a release such as 1.0.0, or latest
JOB_MATCHER_VERSION=latest

# --- Mode ----------------------------------------------------------------------------
# "fake" is demo mode: fixture pages instead of real scrapes and AI calls, no keys, no cost.
# "live" scrapes real job boards and needs both keys below.
PROVIDERS=fake

# --- API keys (live mode) ------------------------------------------------------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# https://www.firecrawl.dev/app/api-keys (the free plan has 1,000 credits a month)
FIRECRAWL_API_KEY=

# --- Tuning (defaults are fine) ------------------------------------------------------
API_PORT=4000
OPENROUTER_MODEL=openai/gpt-6-luna:floor
# Evaluations run on OpenAI's flex tier; max prices are USD per million tokens
OPENROUTER_SERVICE_TIER=flex
OPENROUTER_PROVIDERS=openai
OPENROUTER_MAX_PRICE_PROMPT=0.05
OPENROUTER_MAX_PRICE_COMPLETION=0.25
OPENROUTER_REASONING_EFFORT=low
# This stack scrapes with the Firecrawl cloud. For local or hybrid mode, see
# docs/configuration.md#scraping-modes.
# basic, or auto (retries blocked pages with enhanced proxies)
FIRECRAWL_CLOUD_PROXY=basic
# Cloud credits every run leaves on the plan; scheduled runs keep to a daily share
FIRECRAWL_CREDIT_RESERVE=50
