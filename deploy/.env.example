# Copy to deploy/.env on the host. This file is the template; the real one is never committed.
POSTGRES_PASSWORD=change-me
API_PORT=4000
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
# The public URL people open, e.g. https://jobs.example.com
BETTER_AUTH_URL=http://localhost
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# "fake" runs the public demo on fixtures, with no provider keys or costs
PROVIDERS=fake
FIRECRAWL_API_KEY=
OPENROUTER_API_KEY=
